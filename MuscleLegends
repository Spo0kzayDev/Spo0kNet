end

--// FORMAT ACTIVE TIME

local function FormatActiveTime(StartTime)

    if not StartTime then
        return "0s"
    end

    local Elapsed =
        math.max(0, os.clock() - StartTime)

    local Hours =
        math.floor(Elapsed / 3600)

    local Minutes =
        math.floor((Elapsed % 3600) / 60)

    local Seconds =
        math.floor(Elapsed % 60)

    if Hours > 0 then

        return string.format(
            "%dh %dm %ds",
            Hours,
            Minutes,
            Seconds
        )

    elseif Minutes > 0 then

        return string.format(
            "%dm %ds",
            Minutes,
            Seconds
        )

    else

        return string.format(
            "%ds",
            Seconds
        )

    end

end

