--// KARMA

local function GetPlayerKarma(PlayerObject)

    local GoodKarma =
        PlayerObject:FindFirstChild("goodKarma")

    local EvilKarma =
        PlayerObject:FindFirstChild("evilKarma")

    if not GoodKarma or not EvilKarma then
        return 0, 0
    end

    return tonumber(GoodKarma.Value) or 0,
        tonumber(EvilKarma.Value) or 0

end

--// STRENGTH

local function GetPlayerStrength(PlayerObject)

    local Leaderstats =
        PlayerObject:FindFirstChild("leaderstats")

    if not Leaderstats then
        return 0
    end

    local Strength =
        Leaderstats:FindFirstChild("Strength")

    if not Strength then
        return 0
    end

    return tonumber(Strength.Value) or 0

end

--// CURRENT MAP

local function IsInOverchargedGym(PlayerObject)

    local CurrentMap =
        PlayerObject:FindFirstChild("currentMap")

    if not CurrentMap then
        return false
    end

    return CurrentMap.Value == "Overcharged Gym"

end

--// KARMA FILTER

local function PassesKarmaFilter(PlayerObject)

    if SelectedTargetKarma == "Both" then
        return true
    end

    local GoodKarma, EvilKarma =
        GetPlayerKarma(PlayerObject)

    if SelectedTargetKarma == "Good" then
        return GoodKarma > EvilKarma

    elseif SelectedTargetKarma == "Bad" then
        return EvilKarma > GoodKarma
    end

    return true

end

--// STRENGTH FILTER

local function PassesStrengthFilter(PlayerObject)

    if SelectedTargetStrength == "Everyone" then
        return true
    end

    local LocalStrength =
        GetPlayerStrength(Player)

    local TargetStrength =
        GetPlayerStrength(PlayerObject)

    return TargetStrength < LocalStrength

end

--// GET VALID TARGETS

local function GetValidKillTargets()

    local Targets = {}

    for _, PlayerObject in ipairs(
        Players:GetPlayers()
    ) do

        if PlayerObject ~= Player then

            -- Never target Overcharged Gym
            if not IsInOverchargedGym(PlayerObject) then

                -- Karma filter
                if PassesKarmaFilter(PlayerObject) then

                    -- Strength filter
                    if PassesStrengthFilter(PlayerObject) then

                        table.insert(
                            Targets,
                            PlayerObject
                        )

                    end

                end

            end

        end

    end

    return Targets

end

--// FIND RANDOM TARGET

local function GetRandomKillTarget(Targets)

    if #Targets == 0 then
        return nil
    end

    return Targets[
        math.random(1, #Targets)
    ]

end

--// FIND WEAKEST TARGET

local function GetWeakestKillTarget(Targets)

    if #Targets == 0 then
        return nil
    end

    local Weakest = nil
    local WeakestStrength = math.huge

    for _, PlayerObject in ipairs(Targets) do

        local Strength =
            GetPlayerStrength(PlayerObject)

        if Strength < WeakestStrength then

            WeakestStrength = Strength
            Weakest = PlayerObject

        end

    end

    return Weakest

end

--// FIND PUNCH

local function FindKillPunch()

    local Character =
        Player.Character

    if Character then

        local Equipped =
            Character:FindFirstChild("Punch")

        if Equipped
            and Equipped:IsA("Tool") then

            return Equipped

        end

    end

    local Backpack =
        Player:FindFirstChildOfClass("Backpack")

    if not Backpack then
        return nil
    end

    local Punch =
        Backpack:FindFirstChild("Punch")

    if Punch
        and Punch:IsA("Tool") then

        return Punch

    end

    return nil

end

--// EQUIP PUNCH

local function EquipKillPunch()

    local Punch =
        FindKillPunch()

    if not Punch then
        return nil
    end

    local Character =
        GetCharacter()

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        return nil
    end

    if Punch.Parent ~= Character then

        Humanoid:EquipTool(Punch)

        task.wait()

    end

    CurrentKillPunch = Punch

    return Punch

end

--// TARGET ALIVE

local function IsTargetAlive(Target)

    if not Target then
        return false
    end

    local Character =
        Target.Character

    if not Character then
        return false
    end

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        return false
    end

    return Humanoid.Health > 0

end

--// TARGET STILL VALID

local function IsTargetStillValid(Target)

    if not Target then
        return false
    end

    if Target == Player then
        return false
    end

    if not IsTargetAlive(Target) then
        return false
    end

    if IsInOverchargedGym(Target) then
        return false
    end

    if not PassesKarmaFilter(Target) then
        return false
    end

    if not PassesStrengthFilter(Target) then
        return false
    end

    return true

end

--// MOVE TO TARGET

local function MoveToTarget(Target)

    local MyHRP =
        GetHRP()

    if not MyHRP then
        return
    end

    if not Target then
        return
    end

    local TargetCharacter =
        Target.Character

    if not TargetCharacter then
        return
    end

    local TargetHRP =
        TargetCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if not TargetHRP then
        return
    end

    MyHRP.CFrame =
        TargetHRP.CFrame

end

--// START AUTO KILL

local function StartAutoKill()

    if AutotrainEnabled then

        StopAutotrain()

        AutotrainEnabled = false

    end

    if AutoKillTask then

        task.cancel(AutoKillTask)

        AutoKillTask = nil

    end

    CurrentKillTarget = nil
    CurrentKillPunch = nil

    AutoKillStartTime = os.clock()

    SetSpeedToZero()

    task.wait(0.3)

    SetMovementLocked(true)

    AutoKillTask = task.spawn(function()

        local NoTargetsNotified = false

        while AutoKillEnabled do

            -- Keep movement disabled
            if not MovementLocked then
                SetMovementLocked(true)
            end

            -- Check current target first
            if CurrentKillTarget then

                if not IsTargetStillValid(
                    CurrentKillTarget
                ) then

                    -- Target died / became invalid
                    -- immediately move on
                    CurrentKillTarget = nil

                end

            end

            -- Find a new target
            if not CurrentKillTarget then

                local Targets =
                    GetValidKillTargets()

                if #Targets > 0 then

                    -- We have targets again
                    NoTargetsNotified = false

                    if SelectedTargetStrength
                        == "Killable" then

                        CurrentKillTarget =
                            GetWeakestKillTarget(
                                Targets
                            )

                    else

                        CurrentKillTarget =
                            GetRandomKillTarget(
                                Targets
                            )

                    end

                else

                    -- Nobody available
                    if not NoTargetsNotified then

                        Notify(
                            "Auto Kill",
                            "No valid players available.",
                            3
                        )

                        NoTargetsNotified = true

                    end

                    TeleportToSafezone()

                    task.wait(1)

                    continue

                end

            end

            -- Make sure Punch exists
            local Punch =
                CurrentKillPunch

            if not Punch
                or (
                    Punch.Parent ~= Player.Character
                    and Punch.Parent ~= Player.Backpack
                ) then

                Punch =
                    EquipKillPunch()

            end

            -- Make sure target is still alive
            if not IsTargetStillValid(
                CurrentKillTarget
            ) then

                CurrentKillTarget = nil

                task.wait(0.05)

                continue

            end

            -- Move to target
            MoveToTarget(
                CurrentKillTarget
            )

            -- Activate Punch
            if Punch
                and Punch.Parent == Player.Character then

                Punch:Activate()

            elseif Punch
                and Punch.Parent == Player.Backpack then

                local Character =
                    Player.Character

                local Humanoid =
                    Character
                    and Character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if Humanoid then

                    Humanoid:EquipTool(
                        Punch
                    )

                end

            end

            -- IMPORTANT:
            -- Check immediately after the hit.
            -- If they died, next iteration selects
            -- another player.
            task.wait(0.2)

            if CurrentKillTarget
                and not IsTargetAlive(
                    CurrentKillTarget
                ) then

                CurrentKillTarget = nil

            end

        end

    end)

end

--// STOP AUTO KILL

local function StopAutoKill()

    local WasEnabled =
        AutoKillEnabled

    AutoKillEnabled = false

    if AutoKillTask then

        task.cancel(AutoKillTask)

        AutoKillTask = nil

    end

    CurrentKillTarget = nil
    CurrentKillPunch = nil

    local Character =
