--// FIND STRENGTH TOOL

local function FindTool(Method)

    local Backpack =
        Player:FindFirstChildOfClass("Backpack")

    if not Backpack then
        return nil
    end

    local Tool =
        Backpack:FindFirstChild(Method)

    if Tool and Tool:IsA("Tool") then
        return Tool
    end

    return nil

end

--// FIND BEST STRENGTH TOOL

local function FindBestStrengthTool()

    if SelectedStrengthMethod ~= "Auto" then

        local Tool =
            FindTool(SelectedStrengthMethod)

        if Tool then
            return Tool, SelectedStrengthMethod
        end

        return nil

    end

    for _, Method in ipairs(StrengthMethods) do

        local Tool =
            FindTool(Method)

        if Tool then
            return Tool, Method
        end

    end

    return nil

end

--// FIND HIGHER PRIORITY TOOL

local function FindHigherPriorityTool()

    if not CurrentTrainingMethod then
        return nil
    end

    for _, Method in ipairs(StrengthMethods) do

        if Method == CurrentTrainingMethod then
            break
        end

        local Tool =
            FindTool(Method)

        if Tool then
            return Tool, Method
        end

    end

    return nil

end

--// SWITCH STRENGTH TOOL

local function SwitchTrainingTool(Tool, Method)

    if not Tool then
        return
    end

    local Character =
        GetCharacter()

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        return
    end

    Humanoid:UnequipTools()

    task.wait()

    CurrentTrainingTool = Tool
    CurrentTrainingMethod = Method

    Humanoid:EquipTool(Tool)

end

--// SAFEZONE

local SafezonePosition = Vector3.new(
    -44,
    298,
    2822
)

local SafezoneCheckDistance = 15

local function TeleportToSafezone()

    local HRP = GetHRP()

    if HRP then

        HRP.CFrame =
            CFrame.new(SafezonePosition)

    end

end

local function IsAtSafezone()

    local HRP = GetHRP()

    if not HRP then
        return false
    end

    return (
        HRP.Position - SafezonePosition
    ).Magnitude <= SafezoneCheckDistance

end

local function EnforceSafezone()

    if not AutotrainEnabled
        or not TeleportToSafezoneEnabled then
        return
    end

    local HRP = GetHRP()

    if not HRP then
        return
    end

    if not IsAtSafezone() then
        TeleportToSafezone()
    end

end

--// RETURN TO OLD POSITION

local function ReturnToOldPosition()

    if not OldPosition then
        return
    end

    local HRP = GetHRP()

    if HRP then
        HRP.CFrame = OldPosition
    end

    OldPosition = nil

end

--// START STRENGTH AUTOTRAIN

local function StartStrengthAutotrain()

    CurrentTrainingTool = nil
    CurrentTrainingMethod = nil

    if TeleportToSafezoneEnabled then

        local HRP = GetHRP()

        if HRP then
            OldPosition = HRP.CFrame
        end

        TeleportToSafezone()

        SetMovementLocked(true)

    else

        SetMovementLocked(false)

    end

    local Tool, Method =
        FindBestStrengthTool()

    if not Tool then

        Notify(
            "Autotrain",
            "No strength training tool available.",
            3
        )

        return

    end

    SwitchTrainingTool(
        Tool,
        Method
    )

    local CheckTimer = 0

    AutotrainTask = task.spawn(function()

        while AutotrainEnabled do

            if TeleportToSafezoneEnabled then

                EnforceSafezone()

                if not MovementLocked then
                    SetMovementLocked(true)
                end

            else

                if MovementLocked then
                    SetMovementLocked(false)
                end

            end

            -- Check current tool
            if CurrentTrainingTool then

                local Character =
                    Player.Character

                local ToolStillExists =
                    CurrentTrainingTool.Parent
                        == Player.Backpack
                    or (
                        Character
                        and CurrentTrainingTool.Parent
                            == Character
                    )

                if not ToolStillExists then

                    CurrentTrainingTool = nil
                    CurrentTrainingMethod = nil

                    local NewTool, NewMethod =
                        FindBestStrengthTool()

                    if NewTool then

                        SwitchTrainingTool(
                            NewTool,
                            NewMethod
                        )

                    end

                end

            end

            -- Find a tool if we don't have one
            if not CurrentTrainingTool then

                local NewTool, NewMethod =
                    FindBestStrengthTool()

                if NewTool then

                    SwitchTrainingTool(
                        NewTool,
                        NewMethod
                    )

                end

            else

                local Character =
                    Player.Character

                if Character
                    and CurrentTrainingTool.Parent
                        == Character then

                    CurrentTrainingTool:Activate()

                elseif CurrentTrainingTool.Parent
                    == Player.Backpack then

                    local Humanoid =
                        Character
                        and Character:FindFirstChildOfClass("Humanoid")

                    if Humanoid then

                        Humanoid:EquipTool(
                            CurrentTrainingTool
                        )

                    end

                end

            end

            -- Check for better method every second
            CheckTimer += 0.2

            if CheckTimer >= 1 then

                CheckTimer = 0

                if SelectedStrengthMethod == "Auto"
                    and CurrentTrainingTool then

                    local BetterTool, BetterMethod =
                        FindHigherPriorityTool()

                    if BetterTool then

                        SwitchTrainingTool(
                            BetterTool,
                            BetterMethod
                        )

                    end

                end

            end

            task.wait(0.2)

        end

    end)

end

--// START AUTOTRAIN

local function StartAutotrain()

    if AutoKillEnabled then
        StopAutoKill()
        AutoKillEnabled = false
    end

    if AutotrainTask then

        task.cancel(AutotrainTask)

        AutotrainTask = nil

    end

    CurrentTrainingTool = nil
    CurrentTrainingMethod = nil

    AutotrainStartTime = os.clock()

    SetSpeedToZero()

    task.wait(0.3)

    StartStrengthAutotrain()

end

--// STOP AUTOTRAIN

local function StopAutotrain()

    local WasEnabled =
        AutotrainEnabled

    AutotrainEnabled = false

    if AutotrainTask then

        task.cancel(AutotrainTask)

        AutotrainTask = nil

    end

    local Character =
        Player.Character

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Humanoid:UnequipTools()
    end

    SetMovementLocked(false)

    CurrentTrainingTool = nil
    CurrentTrainingMethod = nil

    if TeleportToSafezoneEnabled then
        ReturnToOldPosition()
    end

    if WasEnabled then

        Notify(
            "Autotrain Disabled",
            "Active for " ..
            FormatActiveTime(AutotrainStartTime),
            4
        )

    end

    AutotrainStartTime = nil

end

