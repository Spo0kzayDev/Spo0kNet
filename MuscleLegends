        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid then
        Humanoid:UnequipTools()
    end

    SetMovementLocked(false)

    if WasEnabled then

        Notify(
            "Auto Kill Disabled",
            "Active for " ..
            FormatActiveTime(
                AutoKillStartTime
            ),
            4
        )

    end

    AutoKillStartTime = nil

end

