--==================================================
-- SPOOKNET | PUBLIC UTILITY
--==================================================

-- Read executor configuration //
local Config = _G.Spo0kNetConfig or {
    Yield = true,
    Dex = false,
    Xbox = true,
    AutoLoad = true
}

-- Auto Load on the next teleported experience //
if Config.AutoLoad == true then
    local queueTeleport =
        queue_on_teleport
        or queueonteleport
        or (syn and syn.queue_on_teleport)

    if type(queueTeleport) == "function" then
        local queuedConfig = string.format(
            "_G.Spo0kNetConfig = { Yield = %s, Dex = %s, Xbox = %s, AutoLoad = true }; _G.LoadedScripts = {}; loadstring(game:HttpGet(%q))()",
            tostring(Config.Yield == true),
            tostring(Config.Dex == true),
            tostring(Config.Xbox == true),
            "https://raw.githubusercontent.com/Spo0kzayDev/Spo0kNet/main/PublicUtility"
        )

        local success, err = pcall(queueTeleport, queuedConfig)
        if success then
            print("Initialiser | Auto Load queued for next game.")
        else
            warn("Initialiser | Auto Load could not be queued: " .. tostring(err))
        end
    else
        warn("Initialiser | Auto Load unsupported by this executor.")
    end
end

-- Load //
if not game:IsLoaded() then
    game.Loaded:Wait()
end

-- Xbox Menu / Teleport Guard //
local TARGET = 13086985452

if Config.Xbox == true and game.PlaceId ~= TARGET then
    local UIS = game:GetService("UserInputService")
    local TeleportService = game:GetService("TeleportService")

    local escHeld = false
    local teleporting = false

    UIS.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Escape then
            escHeld = true
        elseif input.KeyCode == Enum.KeyCode.L and escHeld and not teleporting then
            teleporting = true
            TeleportService:Teleport(TARGET)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Escape then
            escHeld = false
        end
    end)

    print("Initialiser | Xbox Menu enabled")
else
    print("Initialiser | Xbox Menu disabled")
end

-- Set State //
_G.LoadedScripts = _G.LoadedScripts or {}

-- Loader Function //
local function LoadScript(name, activated, url)
    if not activated then
        print("Initialiser | " .. name .. " disabled. Skipping.")
        return
    end

    if _G.LoadedScripts[name] then
        warn("----------")
        warn("Initialiser | " .. name .. " is already loaded. Skipping..")
        warn("----------")
        return
    end

    _G.LoadedScripts[name] = true

    print("----------")
    print("Initialiser | Loading: " .. name)

    local success, err = pcall(function()
        local source = game:HttpGet(url)
        local scriptFunction = loadstring(source)

        if not scriptFunction then
            error("Initialiser | Failed to compile script source.")
        end

        scriptFunction()
    end)

    if not success then
        _G.LoadedScripts[name] = nil
        warn("----------")
        warn("Initialiser | " .. name .. " failed to load: " .. tostring(err))
        warn("----------")
        return
    end

    print("Initialiser | Loaded " .. name .. " successfully.")
end

-- Scripts //
LoadScript(
    "Yield",
    Config.Yield == true,
    "https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"
)

if Config.Yield == true and Config.Dex == true then
    task.wait(5)
end

LoadScript(
    "Dex",
    Config.Dex == true,
    "https://github.com/Tesker-103/DexRecontinued/releases/latest/download/out.lua"
)

print("----------")
print("Initialiser | All scripts processed.")
