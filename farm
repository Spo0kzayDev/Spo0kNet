--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return Player.Character or Player.CharacterAdded:Wait()
end

local function getHumanoid()
	local Character = getCharacter()
	return Character:WaitForChild("Humanoid")
end

local function getRoot()
	local Character = getCharacter()
	return Character:WaitForChild("HumanoidRootPart")
end

--==================================================
-- ZONE FUNCTIONS
--==================================================

local function getZoneCenter(Points)
	local Center = Vector3.zero

	for _, Point in ipairs(Points) do
		Center += Point
	end

	return Center / #Points
end

local function getClosestZone()
	local Root = getRoot()

	local ClosestZone = nil
	local ClosestDistance = math.huge

	for _, Points in pairs(Zones) do
		local Center = getZoneCenter(Points)
		local Distance = (Root.Position - Center).Magnitude

		if Distance < ClosestDistance then
			ClosestDistance = Distance
			ClosestZone = Points
		end
	end

	return ClosestZone
end

--==================================================
-- TOKEN FUNCTION
--==================================================

local function touchToken(Token)
	if not Token or not Token.Parent then
		return
	end

	local Root

	pcall(function()
		Root = getRoot()
	end)

	if not Root or not Root.Parent then
		return
	end

	pcall(function()
		if Token:IsA("BasePart") then

			firetouchinterest(Root, Token, 0)
			task.wait()
			firetouchinterest(Root, Token, 1)

		elseif Token:IsA("Model") then

			local Part = Token.PrimaryPart
				or Token:FindFirstChildWhichIsA("BasePart")

			if Part then
				firetouchinterest(Root, Part, 0)
				task.wait()
				firetouchinterest(Root, Part, 1)
			end
		end
	end)
end

--==================================================
-- TOKEN LOOP
-- ALWAYS ACTIVE
--==================================================

task.spawn(function()
	while true do

		for _, Token in ipairs(Tokens:GetChildren()) do
			task.spawn(touchToken, Token)
		end

		task.wait(1)
	end
end)

--==================================================
-- BLOCK MOVEMENT KEYS
--==================================================

local MovementKeys = {
	Enum.KeyCode.W,
	Enum.KeyCode.A,
	Enum.KeyCode.S,
	Enum.KeyCode.D,

	Enum.KeyCode.Up,
	Enum.KeyCode.Down,
	Enum.KeyCode.Left,
	Enum.KeyCode.Right
}

local function BlockMovement()
	if Enabled then
		return Enum.ContextActionResult.Sink
	end

	return Enum.ContextActionResult.Pass
end

local function SetMovementBlocked(State)
	if State then

		CAS:BindAction(
			"Spo0kNet_BlockMovement",
			BlockMovement,
			false,
			table.unpack(MovementKeys)
		)

	else

		CAS:UnbindAction("Spo0kNet_BlockMovement")

	end
end

--==================================================
-- MOVE TO POINT
--==================================================

local function MoveToPoint(Position)
	if not Enabled then
		return false
	end

	local Humanoid

	pcall(function()
		Humanoid = getHumanoid()
	end)

	if not Humanoid or Humanoid.Health <= 0 then
		return false
	end

	Humanoid:MoveTo(Position)

	-- Don't wait forever for MoveToFinished
	local StartTime = tick()
	local Timeout = 3

	while Enabled and Humanoid.Health > 0 do

		local Root = getRoot()

		if (Root.Position - Position).Magnitude <= 4 then
			return true
		end

		if tick() - StartTime >= Timeout then
			return true
		end

		task.wait(0.1)
	end

	return false
end

--==================================================
-- ZONE MOVEMENT LOOP
--==================================================

task.spawn(function()

	while true do

		if Enabled then

			local Zone = getClosestZone()

			if Zone then

				for _, Position in ipairs(Zone) do

					if not Enabled then
						break
					end

					MoveToPoint(Position)

					task.wait(0.1)
				end
			end

		end

		task.wait(0.1)
	end

end)

--==================================================
-- TOGGLE
--==================================================

UIS.InputBegan:Connect(function(Input, Processed)

	if Processed then
		return
	end

	if Input.KeyCode ~= Enum.KeyCode.Equals then
		return
	end

	Enabled = not Enabled

	SetMovementBlocked(Enabled)

	print("Zone Movement:", Enabled and "ON" or "OFF")

end)

--==================================================
-- CLEAN UP ON CHARACTER RESPAWN
--==================================================

Player.CharacterAdded:Connect(function()

	task.wait(1)

	if Enabled then
		SetMovementBlocked(true)
	end

end)
