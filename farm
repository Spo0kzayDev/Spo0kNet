--// =========================
--// AUTOFARM MOVEMENT
--// =========================

local SpinConnection = nil

local function StopSpinning()

    if SpinConnection then

        pcall(function()
            SpinConnection:Disconnect()
        end)

        SpinConnection = nil
    end
end

local function StartSpinning()

    StopSpinning()

    SpinConnection =
        game:GetService("RunService").RenderStepped:Connect(
        function()

            if not AutoFarmEnabled then
                return
            end

            local Character = Player.Character

            if not Character then
                return
            end

            local HRP =
                Character:FindFirstChild("HumanoidRootPart")

            if not HRP then
                return
            end

            HRP.CFrame =
                HRP.CFrame
                * CFrame.Angles(
                    0,
                    math.rad(SpinSpeed * 10),
                    0
                )
        end
    )

    AddConnection(SpinConnection)
end

local function StartWalking()

    task.spawn(function()

        while AutoFarmEnabled
            and not Unloaded
            and CurrentMethod == "Walking" do

            local Field = Fields[CurrentField]

            if not Field then
                break
            end

            local Character = Player.Character

            if not Character then
                task.wait()
                continue
            end

            local Humanoid =
                Character:FindFirstChildOfClass("Humanoid")

            if not Humanoid then
                task.wait()
                continue
            end

            Humanoid.WalkSpeed = WalkSpeed

            for _, Point in ipairs(Field.Points) do

                if not AutoFarmEnabled
                    or Unloaded
                    or CurrentMethod ~= "Walking" then
                    break
                end

                Humanoid:MoveTo(Point)
                Humanoid.MoveToFinished:Wait()
            end
        end
    end)
end

local function StartAutofarm()

    if not AutoFarmEnabled then
        return
    end

    local Field = Fields[CurrentField]

    if not Field then
        return
    end

    local Character = GetCharacter()

    if Character then
        Character:PivotTo(
            CFrame.new(Field.TP)
        )
    end

    task.wait(0.2)

    if CurrentMethod == "Walking" then

        StopSpinning()
        StartWalking()

    elseif CurrentMethod == "Spin" then

        local Humanoid = GetHumanoid()

        if Humanoid then
            Humanoid.WalkSpeed = BaseWalkSpeed
        end

        StartSpinning()
    end
end

local function StopAutofarm()

    AutoFarmEnabled = false

    StopSpinning()

    local Humanoid = GetHumanoid()

    if Humanoid then

        Humanoid:Move(
            Vector3.zero,
            false
        )

        Humanoid.WalkSpeed =
            BaseWalkSpeed
    end
end

