local TokensFolder = workspace:WaitForChild("Tokens")

Autofarm:CreateToggle({
    name = "🧲 Auto Collect Tokens",
    flag = "AutoCollectTokens",

    callback = function(Value)
        AutoCollectTokens = Value
    end
})

task.spawn(function()
    while not Unloaded do
        task.wait(1)

        if AutoCollectTokens then

            local Character = Player.Character

            if Character then

                local HRP =
                    Character:FindFirstChild("HumanoidRootPart")

                if HRP then

                    for _, Token in ipairs(
                        TokensFolder:GetChildren()
                    ) do

                        if Token:IsA("BasePart") then

                            pcall(function()
                                firetouchinterest(
                                    HRP,
                                    Token,
                                    0
                                )

                                firetouchinterest(
                                    HRP,
                                    Token,
                                    1
                                )
                            end)

                        elseif Token:IsA("Model") then

                            local Part =
                                Token.PrimaryPart
                                or Token:FindFirstChildWhichIsA(
                                    "BasePart",
                                    true
                                )

                            if Part then

                                pcall(function()
                                    firetouchinterest(
                                        HRP,
                                        Part,
                                        0
                                    )

                                    firetouchinterest(
                                        HRP,
                                        Part,
                                        1
                                    )
                                end)

                            end
                        end
                    end
                end
            end
        end
    end
end)
