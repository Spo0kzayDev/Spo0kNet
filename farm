--// =========================
--// AUTO COLLECT TOKENS
--// =========================

Autofarm:CreateToggle({
    name = "🧲 Auto Collect Tokens",
    flag = "AutoCollectTokens",

    callback = function(value)
        AutoCollectTokens = value
    end
})

task.spawn(function()

    while true do

        if AutoCollectTokens then

            local Character = Player.Character
            local HRP =
                Character
                and Character:FindFirstChild("HumanoidRootPart")

            local Tokens =
                workspace:FindFirstChild("Tokens")

            if HRP and Tokens then

                local TokenParts = {}

                for _, Token in ipairs(
                    Tokens:GetDescendants()
                ) do

                    if Token:IsA("BasePart") then
                        table.insert(TokenParts, Token)
                    end
                end

                -- Touch every token
                for _, Token in ipairs(TokenParts) do

                    if not AutoCollectTokens then
                        break
                    end

                    pcall(function()
                        firetouchinterest(
                            HRP,
                            Token,
                            0
                        )
                    end)
                end

                -- Release every token
                for _, Token in ipairs(TokenParts) do

                    if not AutoCollectTokens then
                        break
                    end

                    pcall(function()
                        firetouchinterest(
                            HRP,
                            Token,
                            1
                        )
                    end)
                end
            end
        end

        task.wait(1)
    end
end)

