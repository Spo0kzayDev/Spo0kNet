local function ActivateUpgradeButton(Button)
    if not Button then
        return false
    end

    local Success = pcall(function()
        firesignal(Button.MouseButton1Click)
    end)

    return Success
end

local function CheckDamageUpgrade()
    if not AutoUpgradeDamage then
        return false
    end

    local Button =
        workspace
        :WaitForChild("UpgradePanels")
        :WaitForChild("OreDamageMulti1")
        :WaitForChild("SurfaceGui")
        :WaitForChild("Frame")
        :WaitForChild("PurchaseButton")

    local Color = Button.BackgroundColor3

    -- Red = unavailable, continue mining
    if Color == Color3.fromRGB(177, 0, 0) then
        return false
    end

    -- Green = purchasable
    if Color == Color3.fromRGB(0, 206, 7) then

        -- Pause mining
        AutoMineEnabled = false

        local Character = GetCharacter()

        Character:PivotTo(
            CFrame.new(2045, 1, 751)
        )

        task.wait(0.15)

        ActivateUpgradeButton(Button)

        task.wait(0.25)

        AutoMineEnabled = true

        return true
    end

    return false
end

