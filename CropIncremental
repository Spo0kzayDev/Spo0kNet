--// =========================

local function EquipAutofarmItem()
    local Character = GetCharacter()
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Backpack = Player:FindFirstChildOfClass("Backpack")

    if not Humanoid or not Backpack then
        return
    end

    local Item = Backpack:FindFirstChildWhichIsA("Tool")

    if not Item then
        return
    end

    EquippedItem = Item

    Humanoid:EquipTool(Item)
end

local function StartItemEquip()
    if EquipConnection then
        EquipConnection:Disconnect()
        EquipConnection = nil
    end

    EquipAutofarmItem()

    EquipConnection = RunService.Heartbeat:Connect(function()
        if not AutoFarmEnabled then
            return
        end

        if not EquippedItem then
            return
        end

        local Character = Player.Character

        if not Character then
            return
        end

        local Humanoid =
            Character:FindFirstChildOfClass("Humanoid")

        local Backpack =
            Player:FindFirstChildOfClass("Backpack")

        if not Humanoid or not Backpack then
            return
        end

        if EquippedItem.Parent == Backpack then
            Humanoid:EquipTool(EquippedItem)
        end
    end)
end

local function StopItemEquip()
    if EquipConnection then
        EquipConnection:Disconnect()
        EquipConnection = nil
    end

    EquippedItem = nil
end

--// =========================
--// SPINNING
--// =========================

local SpinConnection
local SpinAngle = 0

local function StartSpinning()
    if SpinConnection then
        SpinConnection:Disconnect()
        SpinConnection = nil
    end

    SpinConnection = RunService.RenderStepped:Connect(function(dt)
        if not AutoFarmEnabled or CurrentMethod ~= "Spin" then
            return
        end

        local Character = game.Players.LocalPlayer.Character
        if not Character then
            return
        end

        local HRP = Character:FindFirstChild("HumanoidRootPart")
        if not HRP then
            return
        end

        SpinAngle = (SpinAngle + SpinSpeed * dt) % 360

        local Position = HRP.Position

        Character:PivotTo(
            CFrame.new(Position) *
            CFrame.Angles(0, math.rad(SpinAngle), 0)
        )
    end)
end

local function StopSpinning()
    if SpinConnection then
        SpinConnection:Disconnect()
        SpinConnection = nil
    end
end

--// =========================
--// WALK TO POINT
--// =========================

local function WalkToPoint(Point)
    if not AutoFarmEnabled then
        return
    end

    local Humanoid = GetHumanoid()

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    Humanoid.WalkSpeed = WalkSpeed
    Humanoid:MoveTo(Point)

    while AutoFarmEnabled
        and CurrentMethod == "Walking" do

        local HRP = GetHRP()

        if not HRP then
            break
        end

        if (HRP.Position - Point).Magnitude <= 3 then
            break
        end

        task.wait(0.05)
    end
end

--// =========================
--// WALKING LOOP
--// =========================

local function StartWalking(FieldData)
    task.spawn(function()
        while AutoFarmEnabled
            and CurrentMethod == "Walking" do

            for _, Point in ipairs(FieldData.Points) do

                if not AutoFarmEnabled
                    or CurrentMethod ~= "Walking" then
                    break
                end

                WalkToPoint(Point)

                task.wait(0.1)
            end
        end
    end)
end

--// =========================
--// START AUTOFARM
--// =========================

local function StartAutofarm()
    if not AutoFarmEnabled then
        return
    end

    local FieldData = Fields[CurrentField]

    if not FieldData then
        return
    end

    local Character = GetCharacter()

    Character:PivotTo(
        CFrame.new(FieldData.TP)
    )

    BlockMovement()

    local Humanoid = GetHumanoid()

    if Humanoid then
        Humanoid.Jump = false

        Humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Jumping,
            false
        )
    end

    if CurrentMethod == "Spin" then

        StopSpinning()
        StartSpinning()

    elseif CurrentMethod == "Walking" then

        StopSpinning()

        if Humanoid then
            Humanoid.WalkSpeed = WalkSpeed
        end

        StartWalking(FieldData)
    end
end

--// =========================
--// STOP AUTOFARM
--// =========================

local function StopAutofarm()
    AutoFarmEnabled = false

    StopSpinning()
    UnblockMovement()

    local Humanoid = GetHumanoid()

    if Humanoid then
        Humanoid:Move(Vector3.zero, false)

        Humanoid.WalkSpeed = BaseWalkSpeed

        Humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Jumping,
            true
        )

        Humanoid.Jump = false
    end
end

