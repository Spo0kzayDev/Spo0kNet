local MiningStartPosition = Vector3.new(2066, 0, 846)

local MiningOres = {
    "Copper",
    "Iron",
    "Gold",
    "Diamond",
    "Red Beryl"
}

local function GetOrePosition(Ore)
    if Ore:IsA("BasePart") then
        return Ore.Position
    end

    if Ore:IsA("Model") then
        return Ore:GetPivot().Position
    end

    local Part = Ore:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

    if Part then
        return Part.Position
    end

    return nil
end

local function GetOreType(Ore)
    local Name = Ore.Name

    for _, OreName in ipairs(MiningOres) do
        if string.lower(Name) == string.lower(OreName) then
            return OreName
        end
    end

    return nil
end

local function GetHighestPriorityOre()
    local MyOres = workspace:FindFirstChild("MyOres")

    if not MyOres then
        return nil
    end

    local BestOre = nil
    local BestPriority = -math.huge

    for _, Ore in ipairs(MyOres:GetChildren()) do
        local OreType = GetOreType(Ore)

        if OreType then
            local Position = GetOrePosition(Ore)

            if Position then
                local Priority = MiningPriorities[OreType] or 1

                if Priority > BestPriority then
                    BestPriority = Priority
                    BestOre = Ore
                end
            end
        end
    end

    return BestOre
end

local function EquipMiningItem()
    local Character = GetCharacter()
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Backpack = Player:FindFirstChildOfClass("Backpack")

    if not Humanoid or not Backpack then
        return nil
    end

    local Tool = Backpack:FindFirstChildWhichIsA("Tool")

    if not Tool then
        return nil
    end

    Humanoid:EquipTool(Tool)

    return Tool
end

local function StartMining()
    task.spawn(function()
        local Character = GetCharacter()

        Character:PivotTo(CFrame.new(MiningStartPosition))

        while AutoMineEnabled do

            --// =========================
            --// DAMAGE UPGRADE
            --// =========================

            if AutoUpgradeDamage then
                local Button =
                    workspace
                    :WaitForChild("UpgradePanels")
                    :WaitForChild("OreDamageMulti1")
                    :WaitForChild("SurfaceGui")
                    :WaitForChild("Frame")
                    :WaitForChild("PurchaseButton")

                if Button.BackgroundColor3 == Color3.fromRGB(0, 206, 7) then

                    -- Pause mining
                    AutoMineEnabled = false

                    Character = GetCharacter()

                    -- Go to Damage upgrade
                    Character:PivotTo(
                        CFrame.new(2045, 1, 751)
                    )

                    task.wait(0.2)

                    -- Purchase Damage upgrade
                    game:GetService("ReplicatedStorage")
                        .Remotes
                        .Upgrade
                        :FireServer("OreDamageMulti1")

                    task.wait(0.5)

                    -- Resume mining
                    AutoMineEnabled = true

                    continue
                end
            end

            --// =========================
            --// CROP UPGRADE
            --// =========================

            if AutoUpgradeCrop then
                local Button =
                    workspace
                    :WaitForChild("UpgradePanels")
                    :WaitForChild("MuscleMultiUpgrade12")
                    :WaitForChild("SurfaceGui")
                    :WaitForChild("Frame")
                    :WaitForChild("PurchaseButton")

                if Button.BackgroundColor3 == Color3.fromRGB(0, 206, 7) then

                    -- Pause mining
                    AutoMineEnabled = false

                    Character = GetCharacter()

                    -- Go to Crop upgrade
                    Character:PivotTo(
                        CFrame.new(2052, 1, 778)
                    )

                    task.wait(0.2)

                    -- Purchase Crop upgrade
                    game:GetService("ReplicatedStorage")
                        .Remotes
                        .Upgrade
                        :FireServer("MuscleMultiUpgrade12")

                    task.wait(0.5)

                    -- Resume mining
                    AutoMineEnabled = true

                    continue
                end
            end

            --// =========================
            --// FIND HIGHEST PRIORITY ORE
            --// =========================

            local Ore = GetHighestPriorityOre()

            if not Ore then
                task.wait(0.25)
                continue
            end

            if not Ore.Parent then
                task.wait()
                continue
            end

            --// =========================
            --// TELEPORT TO ORE
            --// =========================

            local Position = GetOrePosition(Ore)

            if Position then

                Character = GetCharacter()

                Character:PivotTo(
                    CFrame.new(Position)
                )

                task.wait(0.1)

                -- Equip mining tool
                EquipMiningItem()

                -- Wait for ore to disappear
                while AutoMineEnabled and Ore.Parent do
                    task.wait(0.1)
                end

            else
                task.wait(0.1)
            end
        end
    end)
end

local function StopMining()
    AutoMineEnabled = false
end

