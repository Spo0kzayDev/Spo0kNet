                end

                -- Touch every token
                for _, Token in ipairs(TokenParts) do

                    if not AutoCollectTokens then
                        break
                    end

                    pcall(function()
                        firetouchinterest(
                            HRP,
                            Token,
                            0
                        )
                    end)
                end

                -- Release every token
                for _, Token in ipairs(TokenParts) do

                    if not AutoCollectTokens then
                        break
                    end

                    pcall(function()
                        firetouchinterest(
                            HRP,
                            Token,
                            1
                        )
                    end)
                end
            end
        end

        task.wait(1)
    end
end)

