local MovementKeys = {
    Enum.KeyCode.W,
    Enum.KeyCode.A,
    Enum.KeyCode.S,
    Enum.KeyCode.D,

    Enum.KeyCode.Up,
    Enum.KeyCode.Down,
    Enum.KeyCode.Left,
    Enum.KeyCode.Right,

    Enum.KeyCode.Space
}

local function BlockMovement()
    if MovementLocked then
        return
    end

    MovementLocked = true

    ContextActionService:BindAction(
        "Spo0kNet_BlockMovement",
        function()
            return Enum.ContextActionResult.Sink
        end,
        false,
        table.unpack(MovementKeys)
    )

    local Humanoid = GetHumanoid()

    if Humanoid then
        Humanoid.Jump = false

        Humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Jumping,
            false
        )
    end
end

local function UnblockMovement()
    MovementLocked = false

    pcall(function()
        ContextActionService:UnbindAction(
            "Spo0kNet_BlockMovement"
        )
    end)

    local Humanoid = GetHumanoid()

    if Humanoid then
        Humanoid.Jump = false

        Humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Jumping,
            true
        )
    end
end

--// =========================
