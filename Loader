if not game:IsLoaded() then
    game.Loaded:Wait()
end

local Scripts = {
    [10574518789] = "https://raw.githubusercontent.com/Spo0kzayDev/Spo0kNet/refs/heads/main/CropIncremental",
    [1268927906] = "https://raw.githubusercontent.com/Spo0kzayDev/Spo0kNet/refs/heads/main/MuscleLegends"
}

local ScriptURL = Scripts[game.GameId]

if ScriptURL then
    local Success, Result = pcall(function()
        return loadstring(game:HttpGet(ScriptURL))()
    end)

    if not Success then
        warn("[Spo0kNet] Failed to load game script:", Result)
    end
else
    loadstring(game:HttpGet(
        "https://raw.githubusercontent.com/Spo0kzayDev/Spo0kNet/refs/heads/main/UnsupportedGameInfo"
    ))()
end
