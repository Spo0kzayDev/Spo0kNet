local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local Player = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/gen2"
))()

local Window = Rayfield:CreateWindow({
    name = "Spo0kNet"
})

--// HOME

local Home = Window:CreateTab({
    name = "🏠 Home"
})

--// PLAYER INFO

Home:CreateText({
    text = "👤 DisplayName: " .. Player.DisplayName
})

Home:CreateText({
    text = "🪪 UserName: " .. Player.Name
})


--// COINS

local PlayerGui = Player:WaitForChild("PlayerGui")

local Coins = PlayerGui
    :WaitForChild("HUD")
    :WaitForChild("Holder")
    :WaitForChild("LeftList")
    :WaitForChild("YourCoins")
    :WaitForChild("Coins")

local CoinsText = Home:CreateText({
    text = "💰 Coins: Loading..."
})

local function UpdateCoins()

    CoinsText:Set(
        "💰 Coins: " .. Coins.Text
    )

end

UpdateCoins()

Coins:GetPropertyChangedSignal("Text"):Connect(function()

    CoinsText:Set(
        "💰 Coins: " .. Coins.Text
    )

end)


Home:CreateDivider()


--// REJOIN SERVER

Home:CreateButton({
    name = "🔄 Rejoin Server",

    callback = function()

        Window:Popup({
            title = "Rejoin Server?",
            content = "Are you sure you want to rejoin the current server?",

            options = {

                {
                    text = "Cancel",
                    style = "neutral"
                },

                {
                    text = "Rejoin",
                    style = "primary",

                    callback = function()

                        queue_on_teleport([[
                            loadstring(game:HttpGet(
                                "https://raw.githubusercontent.com/Spo0kzayDev/Spo0kNet/main/farm"
                            ))()
                        ]])

                        TeleportService:TeleportToPlaceInstance(
                            game.PlaceId,
                            game.JobId,
                            Player
                        )

                    end
                }

            }
        })

    end
})


--// UNLOAD SCRIPT

Home:CreateButton({
    name = "⚠️ Unload Script",

    callback = function()

        Window:Popup({
            title = "Unload Script?",
            content = "Are you sure you want to unload Spo0kNet? This will make you rejoin.",

            options = {

                {
                    text = "Cancel",
                    style = "neutral"
                },

                {
                    text = "Unload",
                    style = "danger",

                    callback = function()

                        TeleportService:TeleportToPlaceInstance(
                            game.PlaceId,
                            game.JobId,
                            Player
                        )

                    end
                }

            }
        })

    end
})

